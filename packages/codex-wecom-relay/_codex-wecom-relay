#compdef codex-wecom-relay

function _codex-wecom-relay {
  local context state state_descr line
  local -A opt_args

  _arguments \
    '(-h --help)'{-h,--help}'[show help]' \
    '--config[bot configuration JSON]:configuration file:_files' \
    '--ws-url[WeCom websocket endpoint]:websocket URL:' \
    '--state-dir[relay state directory]:directory:_files -/' \
    '--log-level[logging level]:level:(DEBUG INFO WARNING ERROR CRITICAL)' \
    '*--codex-home[independent Codex home]:directory:_files -/' \
    '--codex-bin[Codex executable]:executable:_files'
}
