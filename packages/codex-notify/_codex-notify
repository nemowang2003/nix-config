#compdef codex-notify

function _codex-notify {
  local context state state_descr line
  local -A opt_args
  local -a subcommands profiles threads
  subcommands=(
    'route:assign or clear a notification route'
    'pick:interactively choose a session and route'
    'cleanup:remove routes for missing sessions'
    'notify:send a Codex turn notification'
    'drain:send queued ServerChan notifications'
  )

  _arguments -C \
    '1:subcommand:->subcommand' \
    '*::argument:->arguments'

  case $state in
    subcommand)
      _describe 'subcommand' subcommands
      ;;
    arguments)
      case $line[1] in
        route)
          _arguments \
            '1:thread ID:->thread' \
            '2:route profile:->profile'
          case $state in
            thread)
              local -a homes
              if [[ -n $CODEX_NOTIFY_HOMES ]]; then
                homes=("${(@s.:.)CODEX_NOTIFY_HOMES}")
              else
                homes=("${CODEX_HOME:-$HOME/.codex-openai}" "$HOME/.codex-tca")
              fi
              local codex_home database
              for codex_home in "${homes[@]}"; do
                database="$codex_home/state_5.sqlite"
                if [[ -r $database ]]; then
                  threads+=("${(@f)$(@sqlite3@ -readonly "$database" 'SELECT id FROM threads ORDER BY updated_at DESC' 2>/dev/null)}")
                fi
              done
              if (( ${#threads} )); then
                _values -w 'thread ID' "${threads[@]}"
              else
                _message 'thread ID'
              fi
              ;;
            profile)
              local routes="${XDG_CONFIG_HOME:-$HOME/.config}/codex-notify/routes.json"
              if [[ -r $routes ]]; then
                profiles=("${(@f)$(@jq@ -r 'keys[]' "$routes" 2>/dev/null)}")
                _values -w 'route profile' "${profiles[@]}"
              else
                _message 'route profile'
              fi
              ;;
          esac
          ;;
        notify)
          _arguments \
            '--wecom-relay[also send through the WeCom relay]' \
            '--codex-home[home owning this notification]:directory:_files -/' \
            '1:notification title:'
          ;;
      esac
      ;;
  esac
}
